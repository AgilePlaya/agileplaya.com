# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Analytics and public configuration
# (These are optional and prefixed with NEXT_PUBLIC_ to be available in browser)

# Example: Your site URL
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Example: Analytics tracking ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Private environment variables (only available on server side)
# Add any private keys, tokens, or credentials here
# They will NOT be exposed to the browser

# Database URLs, API keys, etc.
# DATABASE_URL=
# API_KEY=
